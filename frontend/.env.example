# Transport mode: mock | direct | express
# mock    - in-memory faithful state machine, no backend needed (steps F1-F9)
# direct  - FastAPI tutor service, frontend holds `state` (PP1 demo)
# express - team Express server, Express holds `state` (target architecture)
VITE_TUTOR_MODE=mock

# Base URL for `direct` mode (the FastAPI tutor service)
VITE_TUTOR_URL=http://localhost:8001

# Base path for `express` mode (the team server)
VITE_EXPRESS_BASE=/api

# Show the thinking-mode (brain) toggle: true | false. Off for the demo: with
# ollama a thinking turn took 155.6 s (180 s server timeout) and evicts the default
# model, so the next normal turn took 15.0 s. Only the exact string "true" enables it.
VITE_SHOW_THINKING_TOGGLE=false
